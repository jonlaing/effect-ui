{
  "name": "@stax-ui/platform",
  "version": "0.1.0",
  "description": "Full-stack meta-framework for Stax applications",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "Jon Laing",
  "repository": {
    "type": "git",
    "url": "https://github.com/stax-ui/stax.git",
    "directory": "packages/platform"
  },
  "keywords": [
    "effect",
    "effect-ts",
    "framework",
    "ssr",
    "full-stack",
    "meta-framework"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@stax-ui/core": "workspace:*"
  },
  "peerDependencies": {
    "@effect/platform": "^0.94.0",
    "@stax-ui/dom": "workspace:^",
    "@stax-ui/router": "workspace:^",
    "effect": "^3.0.0"
  },
  "peerDependenciesMeta": {}
}

{
  "name": "@effex/eslint-plugin",
  "version": "0.0.1",
  "description": "ESLint plugin for Effex - an Effect.ts-based reactive UI framework",
  "type": "module",
  "license": "MIT",
  "author": "Jon Laing",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonlaing/effex.git",
    "directory": "packages/eslint-plugin"
  },
  "keywords": [
    "effex",
    "effect",
    "effect-ts",
    "eslint",
    "eslint-plugin",
    "linting"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.0.0"
  },
  "peerDependencies": {
    "eslint": "^9.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "devDependencies": {
    "tsup": "^8.4.0",
    "typescript": "~5.9.3"
  }
}

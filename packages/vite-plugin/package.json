{
  "name": "@effex/vite-plugin",
  "version": "1.0.0",
  "description": "Vite plugin for Effex applications",
  "type": "module",
  "license": "MIT",
  "author": "Jon Laing",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonlaing/effex.git",
    "directory": "packages/vite-plugin"
  },
  "keywords": [
    "effect",
    "effect-ts",
    "vite",
    "vite-plugin",
    "ssr"
  ],
  "main": "./dist/index.cjs",

  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup"
  },
  "peerDependencies": {
    "@effex/platform": "workspace:^",
    "vite": "^5.0.0 || ^6.0.0 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "@effex/platform": {
      "optional": true
    }
  },
  "devDependencies": {
    "vite": "^7.0.0"
  }
}
